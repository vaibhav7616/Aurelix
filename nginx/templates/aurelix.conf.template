# Rendered to /etc/nginx/conf.d/aurelix.conf with ${DOMAIN} (nginx image envsubst).

# ── port 80: Let's Encrypt challenges, everything else → https ─────────────────────────
server {
  listen 80;
  listen [::]:80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  location / { return 301 https://$host$request_uri; }
}

# ── port 443 ───────────────────────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${DOMAIN};
  client_max_body_size 2m;

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # browsers must use https for this site from now on (1 year)
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }

  location /api/ {
    proxy_pass http://aurelix_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;   # backend marks cookies Secure from this
    proxy_set_header X-Request-Id $request_id;
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;
  }
  location = /health { proxy_pass http://aurelix_backend/health; }
  location = /ready { proxy_pass http://aurelix_backend/ready; }

  location /socket.io/ {
    proxy_pass http://aurelix_backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }

  location / {
    proxy_pass http://aurelix_frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

// Aurelix — PostgreSQL schema (Prisma)
// Demo/simulated trading environment. LIVE accounts disabled until a licensed execution provider is connected.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AccountType {
  DEMO
  LIVE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AssetCategory {
  CRYPTO
  FOREX
  METALS
  INDICES
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  OPEN
  CLOSED
  CANCELLED
  REJECTED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum TxnType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  REFUND
  ADJUSTMENT
  BONUS
  REFERRAL
}

enum BonusStatus {
  ACTIVE
  COMPLETED
  FORFEITED
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum OptionDirection {
  UP
  DOWN
}

enum OptionStatus {
  OPEN
  WON
  LOST
  TIE
}

enum PendingOptionStatus {
  PENDING
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

enum NotificationType {
  TRADE
  ORDER
  DEPOSIT
  WITHDRAWAL
  SECURITY
  SYSTEM
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String?    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole   @default(USER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false)
  /// ISO country from the edge proxy at registration (affiliate CPA rates / restrictions)
  country       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions          Session[]
  accounts          Account[]
  notifications     Notification[]
  auditLogs         AuditLog[]         @relation("ActorLogs")
  withdrawals       Withdrawal[]       @relation("UserWithdrawals")
  deposits          Deposit[]
  affiliate         Affiliate?         @relation("AffiliateOwner")
  affiliateReferral AffiliateReferral? @relation("AffiliateTrader")

  @@index([email])
  @@index([username])
  @@index([status])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  /// set when the refresh token was exchanged for a new one (rotation); a later use of it is theft
  rotatedAt    DateTime?
  /// "remember me": the refresh cookie survives a browser restart
  persistent   Boolean   @default(true)
  /// random per-browser id (X-Device-Id) — affiliate fraud checks only
  deviceId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model Account {
  id            String        @id @default(cuid())
  userId        String
  accountNumber String        @unique
  accountType   AccountType   @default(DEMO)
  currency      String        @default("USD")
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  lockedBalance Decimal       @default(0) @db.Decimal(18, 2)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  positions      Position[]
  trades         Trade[]
  transactions   WalletTransaction[]
  options        BinaryOption[]
  pendingOptions PendingOption[]

  @@index([userId])
  @@index([status])
}

model Asset {
  id           String        @id @default(cuid())
  symbol       String        @unique
  name         String
  category     AssetCategory
  enabled      Boolean       @default(true)
  basePrice    Decimal       @db.Decimal(18, 6)
  volatility   Decimal       @default(0.002) @db.Decimal(10, 6)
  spread       Decimal       @default(0.0005) @db.Decimal(10, 6)
  feeBps       Int           @default(10)
  minOrder     Decimal       @default(1) @db.Decimal(18, 2)
  maxOrder     Decimal       @default(100000) @db.Decimal(18, 2)
  pipSize      Decimal       @default(0.01) @db.Decimal(18, 6)
  payoutPct    Int           @default(80) // binary option payout % of stake on a win
  tradingHours String        @default("24x7")
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders         Order[]
  positions      Position[]
  trades         Trade[]
  options        BinaryOption[]
  pendingOptions PendingOption[]

  @@index([enabled])
  @@index([category])
}

model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal  @default(0) @db.Decimal(18, 4)
  openTime  DateTime
  closeTime DateTime
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  accountId      String
  assetId        String
  side           OrderSide
  amount         Decimal     @db.Decimal(18, 2)
  quantity       Decimal     @db.Decimal(18, 8)
  entryPrice     Decimal     @db.Decimal(18, 6)
  stopLoss       Decimal?    @db.Decimal(18, 6)
  takeProfit     Decimal?    @db.Decimal(18, 6)
  status         OrderStatus @default(OPEN)
  idempotencyKey String?     @unique
  rejectReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([assetId])
  @@index([status])
  @@index([createdAt])
}

model Position {
  id            String         @id @default(cuid())
  userId        String
  accountId     String
  assetId       String
  orderId       String         @unique
  side          OrderSide
  quantity      Decimal        @db.Decimal(18, 8)
  entryPrice    Decimal        @db.Decimal(18, 6)
  currentPrice  Decimal        @db.Decimal(18, 6)
  stopLoss      Decimal?       @db.Decimal(18, 6)
  takeProfit    Decimal?       @db.Decimal(18, 6)
  unrealizedPnl Decimal        @default(0) @db.Decimal(18, 2)
  status        PositionStatus @default(OPEN)
  openedAt      DateTime       @default(now())
  closedAt      DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([assetId])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  accountId   String
  assetId     String
  positionId  String    @unique
  orderId     String
  side        OrderSide
  quantity    Decimal   @db.Decimal(18, 8)
  entryPrice  Decimal   @db.Decimal(18, 6)
  exitPrice   Decimal   @db.Decimal(18, 6)
  realizedPnl Decimal   @db.Decimal(18, 2)
  fee         Decimal   @default(0) @db.Decimal(18, 2)
  openedAt    DateTime
  closedAt    DateTime  @default(now())
  closeReason String    @default("MANUAL")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([assetId])
  @@index([closedAt])
}

/// Fixed-time (binary) option — the main product. Stake is debited on open;
/// at expiry the server compares the close price to the entry price and credits
/// stake + payout (WON), returns the stake (TIE) or nothing (LOST).
model BinaryOption {
  id             String          @id @default(cuid())
  userId         String
  accountId      String
  assetId        String
  direction      OptionDirection
  stake          Decimal         @db.Decimal(18, 2)
  payoutPct      Int
  entryPrice     Decimal         @db.Decimal(18, 6)
  closePrice     Decimal?        @db.Decimal(18, 6)
  profit         Decimal?        @db.Decimal(18, 2) // net result: +payout, −stake or 0
  durationSec    Int
  openedAt       DateTime        @default(now())
  expiresAt      DateTime
  settledAt      DateTime?
  status         OptionStatus    @default(OPEN)
  idempotencyKey String?         @unique
  /// settlement proof: time of the quote that decided the trade, and where it came from
  /// (QUOTE = live quote at expiry, EXCHANGE = exchange trade record, REFUND = no price → stake returned)
  closeQuoteAt   DateTime?
  settleSource   String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([status, expiresAt])
  @@index([openedAt])
}

/// Pending trade ("Execution by price"): the stake is reserved in
/// Account.lockedBalance; when the quote reaches targetPrice the server opens a
/// regular BinaryOption for durationSec at the market price.
model PendingOption {
  id           String              @id @default(cuid())
  userId       String
  accountId    String
  assetId      String
  direction    OptionDirection
  stake        Decimal             @db.Decimal(18, 2)
  durationSec  Int
  targetPrice  Decimal             @db.Decimal(18, 6)
  /// true → fires when price rises to targetPrice; false → when it falls to it
  triggerAbove Boolean
  status       PendingOptionStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  validUntil   DateTime
  closedAt     DateTime?
  optionId     String?             @unique
  reason       String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([status, validUntil])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  accountId    String
  type         TxnType
  amount       Decimal  @db.Decimal(18, 2)
  balanceAfter Decimal  @db.Decimal(18, 2)
  reference    String?
  memo         String?
  metadata     Json?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id          String        @id @default(cuid())
  userId      String
  accountId   String
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD")
  provider    String        @default("demo")
  providerRef String?
  /// UTR / transaction hash / bank reference the user submitted — unique, so one payment can't back two deposits
  proofRef    String?       @unique
  /// promo bonus % accepted when the deposit was created; granted when an admin approves it
  bonusPct    Int           @default(0)
  promoCode   String?
  status      DepositStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([status])
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  accountId  String
  amount     Decimal          @db.Decimal(18, 2)
  currency   String           @default("USD")
  method     String           @default("bank")
  details    Json?
  status     WithdrawalStatus @default(REQUESTED)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("USD")
  provider    String   @default("demo")
  providerRef String?
  status      String   @default("PENDING")
  raw         Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model RiskRule {
  id                String   @id @default(cuid())
  key               String   @unique
  maxOrderAmount    Decimal  @db.Decimal(18, 2)
  minOrderAmount    Decimal  @db.Decimal(18, 2)
  maxPositionAmount Decimal  @db.Decimal(18, 2)
  maxOpenPositions  Int
  maxDailyLoss      Decimal  @db.Decimal(18, 2)
  maxTotalLoss      Decimal  @db.Decimal(18, 2)
  /// max |open UP stake − open DOWN stake| on one asset across live accounts (0 = no limit)
  maxAssetExposure  Decimal  @default(0) @db.Decimal(18, 2)
  tradingEnabled    Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@index([key])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  key       String   @id
  userId    String
  route     String
  response  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// Deposit bonus: credited to the live balance, locked from withdrawal until the trading
/// turnover requirement is met; withdrawing into it early forfeits it.
model Bonus {
  id               String      @id @default(cuid())
  userId           String
  accountId        String
  depositId        String?     @unique
  code             String?
  amount           Decimal     @db.Decimal(18, 2)
  turnoverRequired Decimal     @db.Decimal(18, 2)
  turnoverDone     Decimal     @default(0) @db.Decimal(18, 2)
  status           BonusStatus @default(ACTIVE)
  createdAt        DateTime    @default(now())
  closedAt         DateTime?

  @@index([accountId, status])
  @@index([userId])
}

// ── Affiliate programme ───────────────────────────────────────────────────────────────

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum AffiliateModel {
  REVSHARE
  TURNOVER
  CPA
}

/// A partner who brings traders. One per user; approved and verified by an admin.
model Affiliate {
  id             String               @id @default(cuid())
  userId         String               @unique
  user           User                 @relation("AffiliateOwner", fields: [userId], references: [id], onDelete: Cascade)
  status         AffiliateStatus      @default(PENDING)
  verified       Boolean              @default(false)
  country        String?
  trafficSources String
  payoutMethod   String?
  payoutDetails  Json?
  /// who invited this affiliate (sub-affiliate programme)
  parentId       String?
  parent         Affiliate?           @relation("SubAffiliates", fields: [parentId], references: [id], onDelete: SetNull)
  /// code for inviting other affiliates
  subCode        String               @unique
  telegramChatId String?
  telegramCode   String?              @unique
  note           String?
  approvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  children       Affiliate[]          @relation("SubAffiliates")
  links          AffiliateLink[]
  promoCodes     AffiliatePromoCode[]
  referrals      AffiliateReferral[]
  ledger         AffiliateLedger[]
  payouts        AffiliatePayout[]
  postbacks      AffiliatePostback[]
  tickets        AffiliateTicket[]

  @@index([parentId])
  @@index([status])
}

/// Tracking link: fixes the commission model for traders who register through it.
model AffiliateLink {
  id          String              @id @default(cuid())
  /// public numeric link id (?lid=123456)
  num         Int                 @unique @default(autoincrement())
  affiliateId String
  affiliate   Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  code        String              @unique
  name        String
  model       AffiliateModel
  subId       String?
  landing     String              @default("/")
  archived    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  clicks      AffiliateClick[]
  referrals   AffiliateReferral[]

  @@index([affiliateId])
}

model AffiliateClick {
  id        String        @id @default(cuid())
  linkId    String
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  subId     String?
  clickId   String?
  ipHash    String?
  country   String?
  createdAt DateTime      @default(now())

  @@index([linkId, createdAt])
}

model AffiliatePromoCode {
  id          String         @id @default(cuid())
  affiliateId String
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  code        String         @unique
  model       AffiliateModel
  createdAt   DateTime       @default(now())

  @@index([affiliateId])
}

/// A trader brought by an affiliate. Model and share are fixed at registration, permanently.
model AffiliateReferral {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation("AffiliateTrader", fields: [userId], references: [id], onDelete: Cascade)
  affiliateId        String
  affiliate          Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  linkId             String?
  link               AffiliateLink?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  promoCodeId        String?
  model              AffiliateModel
  level              Int
  /// RevShare % or Turnover % from the affiliate's level at registration time
  sharePct           Decimal           @db.Decimal(6, 2)
  subId              String?
  clickId            String?
  /// SUSPICIOUS: fraud checks matched — commission is held for admin review
  status             String            @default("ACTIVE")
  flags              String?
  registeredAt       DateTime          @default(now())
  ftdAt              DateTime?
  ftdAmount          Decimal?          @db.Decimal(18, 2)
  depositTotal       Decimal           @default(0) @db.Decimal(18, 2)
  activeTraderAt     DateTime?
  cpaAt              DateTime?
  turnoverCommission Decimal           @default(0) @db.Decimal(18, 2)
  ledger             AffiliateLedger[]

  @@index([affiliateId, registeredAt])
}

/// Every commission movement. Balance = sum of ACCRUED rows (payouts are negative rows).
model AffiliateLedger {
  id          String             @id @default(cuid())
  affiliateId String
  affiliate   Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// REVSHARE | TURNOVER | CPA | SUBAFFILIATE | PAYOUT | PAYOUT_REVERSAL | ADJUSTMENT
  type        String
  amount      Decimal            @db.Decimal(18, 2)
  /// ACCRUED | HELD | CANCELLED
  status      String             @default("ACCRUED")
  uniqueKey   String             @unique
  referralId  String?
  referral    AffiliateReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  refId       String?
  note        String?
  createdAt   DateTime           @default(now())

  @@index([affiliateId, status, createdAt])
  @@index([referralId])
}

model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(18, 2)
  /// REQUESTED | PAID | REJECTED
  status      String    @default("REQUESTED")
  periodEnd   DateTime
  method      String?
  details     Json?
  note        String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([affiliateId])
  @@index([status])
}

model AffiliatePostback {
  id          String                 @id @default(cuid())
  affiliateId String
  affiliate   Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// which events this postback receives: reg | conf | ftd | dep | withdrawal
  events      String[]
  /// GET (parameters in the URL) or POST (parameters in a JSON body)
  method      String                 @default("GET")
  /// tracker names for each event's {status}, e.g. {"ftd":"sale"}
  statusMap   Json?
  url         String
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  logs        AffiliatePostbackLog[]

  @@index([affiliateId])
}

model AffiliatePostbackLog {
  id         String            @id @default(cuid())
  postbackId String
  postback   AffiliatePostback @relation(fields: [postbackId], references: [id], onDelete: Cascade)
  url        String
  status     Int?
  error      String?
  createdAt  DateTime          @default(now())

  @@index([postbackId, createdAt])
}

model AffiliateTicket {
  id          String                   @id @default(cuid())
  affiliateId String
  affiliate   Affiliate                @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  subject     String
  /// OPEN | ANSWERED | CLOSED
  status      String                   @default("OPEN")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  messages    AffiliateTicketMessage[]

  @@index([affiliateId])
}

model AffiliateTicketMessage {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    AffiliateTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean         @default(false)
  body      String
  createdAt DateTime        @default(now())

  @@index([ticketId])
}

// Aurelix — PostgreSQL schema (Prisma)
// Demo/simulated trading environment. LIVE accounts disabled until a licensed execution provider is connected.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AccountType {
  DEMO
  LIVE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AssetCategory {
  CRYPTO
  FOREX
  METALS
  INDICES
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  OPEN
  CLOSED
  CANCELLED
  REJECTED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum TxnType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  REFUND
  ADJUSTMENT
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum OptionDirection {
  UP
  DOWN
}

enum OptionStatus {
  OPEN
  WON
  LOST
  TIE
}

enum NotificationType {
  TRADE
  ORDER
  DEPOSIT
  WITHDRAWAL
  SECURITY
  SYSTEM
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String?    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole   @default(USER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions      Session[]
  accounts      Account[]
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("ActorLogs")
  withdrawals   Withdrawal[]   @relation("UserWithdrawals")
  deposits      Deposit[]

  @@index([email])
  @@index([username])
  @@index([status])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id            String        @id @default(cuid())
  userId        String
  accountNumber String        @unique
  accountType   AccountType   @default(DEMO)
  currency      String        @default("USD")
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  lockedBalance Decimal       @default(0) @db.Decimal(18, 2)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  positions    Position[]
  trades       Trade[]
  transactions WalletTransaction[]
  options      BinaryOption[]

  @@index([userId])
  @@index([status])
}

model Asset {
  id           String        @id @default(cuid())
  symbol       String        @unique
  name         String
  category     AssetCategory
  enabled      Boolean       @default(true)
  basePrice    Decimal       @db.Decimal(18, 6)
  volatility   Decimal       @default(0.002) @db.Decimal(10, 6)
  spread       Decimal       @default(0.0005) @db.Decimal(10, 6)
  feeBps       Int           @default(10)
  minOrder     Decimal       @default(1) @db.Decimal(18, 2)
  maxOrder     Decimal       @default(100000) @db.Decimal(18, 2)
  pipSize      Decimal       @default(0.01) @db.Decimal(18, 6)
  payoutPct    Int           @default(80) // binary option payout % of stake on a win (Quotex-style)
  tradingHours String        @default("24x7")
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders    Order[]
  positions Position[]
  trades    Trade[]
  options   BinaryOption[]

  @@index([enabled])
  @@index([category])
}

model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal  @default(0) @db.Decimal(18, 4)
  openTime  DateTime
  closeTime DateTime
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  accountId      String
  assetId        String
  side           OrderSide
  amount         Decimal     @db.Decimal(18, 2)
  quantity       Decimal     @db.Decimal(18, 8)
  entryPrice     Decimal     @db.Decimal(18, 6)
  stopLoss       Decimal?    @db.Decimal(18, 6)
  takeProfit     Decimal?    @db.Decimal(18, 6)
  status         OrderStatus @default(OPEN)
  idempotencyKey String?     @unique
  rejectReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([assetId])
  @@index([status])
  @@index([createdAt])
}

model Position {
  id            String         @id @default(cuid())
  userId        String
  accountId     String
  assetId       String
  orderId       String         @unique
  side          OrderSide
  quantity      Decimal        @db.Decimal(18, 8)
  entryPrice    Decimal        @db.Decimal(18, 6)
  currentPrice  Decimal        @db.Decimal(18, 6)
  stopLoss      Decimal?       @db.Decimal(18, 6)
  takeProfit    Decimal?       @db.Decimal(18, 6)
  unrealizedPnl Decimal        @default(0) @db.Decimal(18, 2)
  status        PositionStatus @default(OPEN)
  openedAt      DateTime       @default(now())
  closedAt      DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([assetId])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  accountId   String
  assetId     String
  positionId  String    @unique
  orderId     String
  side        OrderSide
  quantity    Decimal   @db.Decimal(18, 8)
  entryPrice  Decimal   @db.Decimal(18, 6)
  exitPrice   Decimal   @db.Decimal(18, 6)
  realizedPnl Decimal   @db.Decimal(18, 2)
  fee         Decimal   @default(0) @db.Decimal(18, 2)
  openedAt    DateTime
  closedAt    DateTime  @default(now())
  closeReason String    @default("MANUAL")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([assetId])
  @@index([closedAt])
}

/// Fixed-time (binary) option — the Quotex-style product. Stake is debited on open;
/// at expiry the server compares the close price to the entry price and credits
/// stake + payout (WON), returns the stake (TIE) or nothing (LOST).
model BinaryOption {
  id             String          @id @default(cuid())
  userId         String
  accountId      String
  assetId        String
  direction      OptionDirection
  stake          Decimal         @db.Decimal(18, 2)
  payoutPct      Int
  entryPrice     Decimal         @db.Decimal(18, 6)
  closePrice     Decimal?        @db.Decimal(18, 6)
  profit         Decimal?        @db.Decimal(18, 2) // net result: +payout, −stake or 0
  durationSec    Int
  openedAt       DateTime        @default(now())
  expiresAt      DateTime
  settledAt      DateTime?
  status         OptionStatus    @default(OPEN)
  idempotencyKey String?         @unique

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([status, expiresAt])
  @@index([openedAt])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  accountId    String
  type         TxnType
  amount       Decimal  @db.Decimal(18, 2)
  balanceAfter Decimal  @db.Decimal(18, 2)
  reference    String?
  memo         String?
  metadata     Json?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id          String        @id @default(cuid())
  userId      String
  accountId   String
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD")
  provider    String        @default("demo")
  providerRef String?
  status      DepositStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([status])
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  accountId  String
  amount     Decimal          @db.Decimal(18, 2)
  currency   String           @default("USD")
  method     String           @default("bank")
  details    Json?
  status     WithdrawalStatus @default(REQUESTED)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("USD")
  provider    String   @default("demo")
  providerRef String?
  status      String   @default("PENDING")
  raw         Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model RiskRule {
  id                String   @id @default(cuid())
  key               String   @unique
  maxOrderAmount    Decimal  @db.Decimal(18, 2)
  minOrderAmount    Decimal  @db.Decimal(18, 2)
  maxPositionAmount Decimal  @db.Decimal(18, 2)
  maxOpenPositions  Int
  maxDailyLoss      Decimal  @db.Decimal(18, 2)
  maxTotalLoss      Decimal  @db.Decimal(18, 2)
  tradingEnabled    Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@index([key])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  key       String   @id
  userId    String
  route     String
  response  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

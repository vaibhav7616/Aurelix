# Aurelix production environment — copy to .env.production and fill in EVERY value.
# Generate secrets with:  openssl rand -base64 48
# Never commit .env.production.

POSTGRES_USER=aurelix
POSTGRES_DB=aurelix
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# 32+ random characters each, and different from each other
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public URL of the app (as users type it), and the allowed browser origins (comma-separated)
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# real = Binance feed for crypto + OTC engine for the rest. "demo" is refused in production.
MARKET_PROVIDER=real

# First admin, created on first boot if the email doesn't exist yet. Password: 12+ characters.
# Remove these two lines after the first successful start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Deposit destinations (PRIVATE) ─────────────────────────────────────────────────────
# Where users send money. Read only from this file, never stored in the database.
# Leave a method's values empty and that method is not offered in the cashier.
# Double-check every character: money sent to a wrong address/account cannot be recovered.

# UPI (QR + PhonePe/GPay/Paytm links)
DEPOSIT_UPI_VPA=
DEPOSIT_UPI_PAYEE=

# Bank transfer (IMPS/NEFT/RTGS) — SWIFT is optional
DEPOSIT_BANK_NAME=
DEPOSIT_BANK_BENEFICIARY=
DEPOSIT_BANK_ACCOUNT=
DEPOSIT_BANK_IFSC=
DEPOSIT_BANK_SWIFT=

# Crypto receiving addresses (one per network)
DEPOSIT_CRYPTO_USDT_TRC20=
DEPOSIT_CRYPTO_BTC=
DEPOSIT_CRYPTO_ETH=

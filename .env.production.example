# Aurelix production environment — copy to .env.production and fill in EVERY value.
# Generate secrets with:  openssl rand -base64 48
# Never commit .env.production.

POSTGRES_USER=aurelix
POSTGRES_DB=aurelix
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# 32+ random characters each, and different from each other
JWT_SECRET=
JWT_REFRESH_SECRET=

# Domain served over HTTPS (DNS must point at this server; ports 80 and 443 open).
# First certificate: sh scripts/init-letsencrypt.sh   (renewals are automatic)
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Public URL of the app (as users type it), and the allowed browser origins (comma-separated)
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# real = Binance feed for crypto + OTC engine for the rest. "demo" is refused in production.
MARKET_PROVIDER=real

# Smallest withdrawal users can request (USD)
MIN_WITHDRAWAL_USD=100

# Reverse proxies in front of the backend: 1 = our nginx only (it terminates HTTPS). Add 1 for each
# load balancer or CDN in front of it (e.g. Cloudflare → nginx = 2). Wrong values break per-IP login limits.
TRUST_PROXY_HOPS=1

# First admin, created on first boot if the email doesn't exist yet. Password: 12+ characters.
# Remove these two lines after the first successful start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Deposit destinations (PRIVATE) ─────────────────────────────────────────────────────
# Where users send money. Read only from this file, never stored in the database.
# Leave a method's values empty and that method is not offered in the cashier.
# Double-check every character: money sent to a wrong address/account cannot be recovered.

# UPI (QR + PhonePe/GPay/Paytm links)
DEPOSIT_UPI_VPA=
DEPOSIT_UPI_PAYEE=

# Bank transfer (IMPS/NEFT/RTGS) — SWIFT is optional
DEPOSIT_BANK_NAME=
DEPOSIT_BANK_BENEFICIARY=
DEPOSIT_BANK_ACCOUNT=
DEPOSIT_BANK_IFSC=
DEPOSIT_BANK_SWIFT=

# Crypto receiving addresses (one per network)
DEPOSIT_CRYPTO_USDT_TRC20=
DEPOSIT_CRYPTO_BTC=
DEPOSIT_CRYPTO_ETH=

# ── Support channels (public, shown on the Contact page) ──────────────────────────────
# Leave a value empty to hide that channel.
CONTACT_EMAIL=
CONTACT_WHATSAPP=        # international number, digits only, e.g. 919876543210
CONTACT_TELEGRAM=        # username without @
CONTACT_HOURS=           # e.g. Mon–Sat, 9:00–21:00 IST
